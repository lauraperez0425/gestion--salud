                                        "description": "ID del paciente",
                                        "type": "integer"
                                    },
                                    "medico_id": {
                                        "description": "ID del médico",
                                        "type": "integer"
                                    },
                                    "fecha": {
                                        "description": "Fecha de la cita (Y-m-d)",
                                        "type": "string",
                                        "format": "date"
                                    },
                                    "hora": {
                                        "description": "Hora de la cita (H:i)",
                                        "type": "string",
                                        "format": "time"
